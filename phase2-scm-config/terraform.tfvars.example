# Copy to terraform.tfvars (git-ignored). Credentials are better passed as
# TF_VAR_scm_client_secret etc. than written to disk.
scm_tsg_id    = "<your TSG id>"
scm_client_id = "<service-account>@<tsg>.iam.panserviceaccount.com"
# scm_client_secret -> export TF_VAR_scm_client_secret=...

# folder_name   = "AWS-HA-Transit"
# parent_folder = "ngfw-shared"   # SCM rejects the predefined "All" as a parent

# fw_devices is generated by scripts/scm-onboard-fw.sh (fw_devices.auto.tfvars.json).

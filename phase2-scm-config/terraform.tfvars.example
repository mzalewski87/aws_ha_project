# Copy to terraform.tfvars (git-ignored). Credentials are better passed as
# TF_VAR_scm_client_secret etc. than written to disk.
scm_tsg_id    = "<your TSG id>"
scm_client_id = "<service-account>@<tsg>.iam.panserviceaccount.com"
# scm_client_secret -> export TF_VAR_scm_client_secret=...

# folder_name   = "AWS-HA-Transit"
# parent_folder = "ngfw-shared"   # SCM rejects the predefined "All" as a parent

# fw_devices is generated by scripts/scm-onboard-fw.sh (fw_devices.auto.tfvars.json).
#   (optional per device: untrust_floating, trust_gw, untrust_gw — a pair in another region)

# --- Defaults below match the root defaults (mgmt VPC 10.11.0.0/16, DC 10.13.0.10).
#     Change them together with the root CIDRs, or the rules point at the wrong addresses.
# guac_rdp_source_cidrs = ["10.11.20.0/23"]   # Guacamole subnets -> DC RDP; [] = no rule
# panel_source_cidrs    = ["10.11.30.0/23"]   # panel subnets -> DC LDAP (panel login); [] = no rule
# dc_private_ip         = "10.13.0.10"
# gp_local_ips          = ["10.10.10.100"]    # GP floating IP per region (Region B: add "10.20.10.100")
# dc_replica_ips        = []                  # e.g. ["10.13.0.10", "10.23.0.10"] with a Region B DC

# --- Advanced IP Defense (PANW predefined IP lists): off | alert | block
# ip_defense_mode = "off"
